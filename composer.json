{
    "name": "drupal/varbase_ai_answers_base",
    "description": "Ask AI for Varbase: a public question box that answers from the site's own content with numbered citations and source cards, with AI Answers over the Varbase AI Search vector index. Experimental. Opt-in: never applied by default.",
    "type": "drupal-recipe",
    "keywords": [
        "recipe",
        "Varbase recipes",
        "Drupal recipes",
        "Varbase AI",
        "Drupal AI",
        "AI Search",
        "RAG",
        "Ask AI",
        "AI Answers",
        "citations",
        "Canvas"
    ],
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/Vardot/varbase_ai_answers_base",
    "authors": [
        {
            "name": "Vardot",
            "homepage": "https://www.vardot.com",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/Vardot/varbase_ai_answers_base/issues",
        "source": "https://github.com/Vardot/varbase_ai_answers_base"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "drupal/ai": "^1.4",
        "drupal/ai_agents": "^1.3",
        "drupal/ai_answers": "^1.0@beta",
        "drupal/canvas": "^1.12",
        "drupal/core": "^11.4",
        "drupal/varbase_ai_search_base": "^1.0"
    }
}
